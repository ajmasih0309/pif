# Application configuration
SECRET_KEY=dev-secret-key-change-in-production
DB_PATH=data/processed/pif.db

# Email configuration
MAIL_SERVER=<email_service>
MAIL_PORT=<port_number>
MAIL_USERNAME=<sender_email_address>
MAIL_DEFAULT_SENDER=<sender_email_address>
MAIL_PASSWORD=<16_digit_password>

EMAIL_MODE=preview # preview, test, live, or disabled
EMAIL_LIVE_ENABLED=false
EMAIL_REMINDERS_ENABLED=false

MAIL_TEST_RECIPIENT=<receiver_email_address>
